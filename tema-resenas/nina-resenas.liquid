{%- comment -%}
  Nina Beauty · Reseñas (Judge.me) en la ficha de producto. 2026-11-27.
  La sección solo pone el título y los colores Nina; el widget lo pinta el bloque de app de Judge.me.
  Las estrellas pequeñas bajo el título son el bloque «preview_badge» de Judge.me dentro de los detalles.
{%- endcomment -%}
<style>
  .nina-resenas{background:{{ section.settings.fondo }};padding:44px 0 52px}
  .nina-resenas__in{max-width:1080px;margin:0 auto;padding:0 20px}
  .nina-resenas__t{font-family:var(--font-heading--family);font-weight:600;font-size:clamp(28px,4vw,38px);text-align:center;margin:0 0 6px;color:#2B2B2B;text-transform:lowercase}
  .nina-resenas__s{text-align:center;font-size:13px;color:#6E6E6E;margin:0 0 22px}
  /* Colores Nina para Judge.me (estrellas, barras, botones) */
  .jdgm-star,.jdgm-star.jdgm--on:before,.jdgm-star.jdgm--half:before,.jdgm-star.jdgm--off:before{color:#F72E75 !important}
  .jdgm-histogram__bar-content{background:#F72E75 !important}
  .jdgm-histogram__bar{background:#fff !important;border-radius:9px}
  .jdgm-rev-widg{font-family:var(--font-body--family) !important;color:#2B2B2B}
  .jdgm-rev-widg__title{display:none !important}
  .jdgm-rev-widg__header{background:#fff;border-radius:20px;padding:20px !important}
  .jdgm-rev{background:#fff;border:1px solid #F1E4E8 !important;border-radius:16px;padding:16px 18px !important;margin-top:12px !important}
  .jdgm-rev__title{font-weight:600}
  .jdgm-rev__buyer-badge{background:#FFCCD5 !important;color:#C92F60 !important;border-radius:999px !important;border:0 !important}
  .jdgm-write-rev-link,.jdgm-btn--solid,.jdgm-submit-rev{background:#C92F60 !important;color:#fff !important;border:0 !important;border-radius:999px !important;padding:11px 22px !important;font-weight:600 !important}
  .jdgm-ask-question-link,.jdgm-btn--border{border:1.5px solid #C92F60 !important;color:#C92F60 !important;border-radius:999px !important;background:#fff !important}
  .jdgm-paginate__page.jdgm-curt{color:#C92F60 !important;font-weight:600}
  .jdgm-prev-badge__text{color:#C92F60;font-size:13px}
  .jdgm-widget a{color:#C92F60}
</style>
<section class="nina-resenas" id="opiniones">
  <div class="nina-resenas__in">
    {%- if section.settings.titulo != blank -%}<h2 class="nina-resenas__t">{{ section.settings.titulo }}</h2>{%- endif -%}
    {%- if section.settings.subtitulo != blank -%}<p class="nina-resenas__s">{{ section.settings.subtitulo }}</p>{%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Nina · Opiniones",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "lo que opinan nuestras clientas" },
    { "type": "text", "id": "subtitulo", "label": "Subtítulo", "default": "Opiniones reales de compras verificadas" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#FFF1F4" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Nina · Opiniones" }]
}
{% endschema %}
