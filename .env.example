# Copia estas variables en Railway > tu servicio > Variables. Nunca subas valores reales a GitHub.

# --- Shopify (app creada en el Dev Dashboard, instalada SOLO en la tienda de Nina Beauty) ---
SHOPIFY_SHOP=ikwg4h-mk.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ACCESS_TOKEN=          # alternativa si tienes un token fijo (shpat_...)
# SHOPIFY_LOCATION_ID=           # opcional; si falta, usa la primera ubicación activa

# --- BTS Wholesaler (panel de cliente > API) ---
BTS_TOKEN=                       # el token JWT («Crear Servicio de Cuenta» en la sección API de BTS)
# BTS_API_URL=https://api.btswholesaler.com/v1/api   # ya viene por defecto

# --- Panel ---
PANEL_PASSWORD=                  # la contraseña para entrar al panel
PUBLIC_URL=                      # p. ej. https://nina-sync.up.railway.app (para el enlace del correo)
DRY_RUN=true                     # true = prueba, no cambia nada en Shopify. Pon false cuando revises el primer informe.

# --- Base de datos (Railway la rellena sola al añadir Postgres) ---
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Correo del informe (opcional, Google Workspace con contraseña de aplicación) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=ccornejo@ninabeauty.es
# SMTP_PASS=
# REPORT_TO=ccornejo@ninabeauty.es

# --- Reglas (valores por defecto acordados) ---
# MIN_STOCK=3                    # menos de 3 en BTS => 0 en Shopify
# SYNC_CRON=0 */4 * * *          # cada 4 horas
# TZ_SYNC=Europe/Madrid
# DISPLAY_TZ=America/Santiago    # zona horaria con la que el panel muestra las horas
# OFFER_TAG=oferta-semana
# OFFER_DAYS=7
# MANUAL_PRICE_TAG=precio-manual # productos con esta etiqueta no cambian de precio

# Envío: el cliente paga SHIPPING_PRICE por debajo de FREE_SHIPPING_FROM; desde ahí es gratis
# y los 6 € de BTS (SHIPPING_COST) salen de la ganancia. El envío ya NO va dentro del precio.
SHIPPING_COST=6
SHIPPING_PRICE=4.95
FREE_SHIPPING_FROM=39

# --- Google y descripciones (categoría de Google + descripción breve con IA) ---
OPENAI_API_KEY=                  # tu clave de platform.openai.com/api-keys (solo aquí, en Railway)
# OPENAI_MODEL=gpt-5-mini        # modelo de OpenAI
# OPENAI_WEB_SEARCH=true         # la IA busca en internet las notas si no las conoce (más exacto, algo más caro)
# SEO_AUTO=true                  # false = no hace nada solo (ni productos nuevos ni repaso)
# SEO_CRON=20 * * * *            # repaso de productos pendientes, cada hora
# SEO_MAX_PER_DAY=1500           # tope de consultas a la IA al día
# SEO_SKIP_TAG=seo-manual        # productos con esta etiqueta no se tocan
