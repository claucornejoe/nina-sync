# Copia estas variables en Railway > tu servicio > Variables. Nunca subas valores reales a GitHub.

# --- Shopify (app creada en el Dev Dashboard, instalada SOLO en la tienda de Nina Beauty) ---
SHOPIFY_SHOP=ikwg4h-mk.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ACCESS_TOKEN=          # alternativa si tienes un token fijo (shpat_...)
# SHOPIFY_LOCATION_ID=           # opcional; si falta, usa la primera ubicación activa

# --- BTS Wholesaler (panel de cliente > API) ---
BTS_TOKEN=                       # el token JWT («Crear Servicio de Cuenta» en la sección API de BTS)
# BTS_API_URL=https://api.btswholesaler.com/v1/api   # ya viene por defecto

# --- Panel ---
PANEL_PASSWORD=                  # la contraseña para entrar al panel
PUBLIC_URL=                      # p. ej. https://nina-sync.up.railway.app (para el enlace del correo)
DRY_RUN=true                     # true = prueba, no cambia nada en Shopify. Pon false cuando revises el primer informe.

# --- Base de datos (Railway la rellena sola al añadir Postgres) ---
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Correo del informe (opcional, Google Workspace con contraseña de aplicación) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=ccornejo@ninabeauty.es
# SMTP_PASS=
# REPORT_TO=ccornejo@ninabeauty.es
# Con esto también salen los correos a clientas («¡Ha vuelto!» del botón Avísame), firmados como «Nina Beauty».
# MAIL_FROM=avisos@ninabeauty.es  # remitente de los correos a clientas (ya es el valor por defecto)
#                                # Si avisos@ es un buzón propio, pon también SMTP_USER=avisos@ninabeauty.es y su contraseña de aplicación.
#                                # Si es un alias de otra cuenta, Google lo acepta como remitente sin más.
# MAIL_FROM_NAME=Nina Beauty
# MAIL_REPLY_TO=                 # a dónde llegan las respuestas (por defecto, MAIL_FROM)

# --- Avisos de stock («Agotado · Avísame») ---
# STORE_URL=https://www.ninabeauty.es
# STORE_ORIGINS=https://www.ninabeauty.es,https://ninabeauty.es,https://ikwg4h-mk.myshopify.com
# ALERT_LOW_STOCK_MAX=10         # con esto o menos unidades, el correo dice «Han llegado pocas unidades»
# ALERT_MAX_PER_RUN=400          # tope de correos por revisión (Google Workspace: ~2.000 al día)
# ALERT_EXPIRE_DAYS=180          # sin reposición en este tiempo, se borra el correo

# --- Reglas (valores por defecto acordados) ---
# MIN_STOCK=3                    # menos de 3 en BTS => 0 en Shopify
# SYNC_CRON=0 */4 * * *          # cada 4 horas
# TZ_SYNC=Europe/Madrid
# DISPLAY_TZ=America/Santiago    # zona horaria con la que el panel muestra las horas
# OFFER_TAG=oferta-semana
# OFFER_DAYS=7
# MANUAL_PRICE_TAG=precio-manual # productos con esta etiqueta no cambian de precio

# Envío: el cliente paga SHIPPING_PRICE por debajo de FREE_SHIPPING_FROM; desde ahí es gratis
# y los 6 € de BTS (SHIPPING_COST) salen de la ganancia. El envío ya NO va dentro del precio.
SHIPPING_COST=6
SHIPPING_PRICE=4.95
FREE_SHIPPING_FROM=49

# --- Google y descripciones (categoría de Google + descripción breve con IA) ---
OPENAI_API_KEY=                  # tu clave de platform.openai.com/api-keys (solo aquí, en Railway)
# OPENAI_MODEL=gpt-5-mini        # modelo de OpenAI
# OPENAI_WEB_SEARCH=true         # la IA busca en internet las notas si no las conoce (más exacto, algo más caro)
# SEO_AUTO=true                  # false = no hace nada solo (ni productos nuevos ni repaso)
# SEO_CRON=20 * * * *            # repaso de productos pendientes, cada hora
# SEO_MAX_PER_DAY=1500           # tope de consultas a la IA al día
# SEO_SKIP_TAG=seo-manual        # productos con esta etiqueta no se tocan
# NO_PHOTO_URL=                  # foto provisional para productos sin foto (por defecto, el logo public/sin-foto.png del panel)
# ICECAT_USER=openIcecat-live   # usuario de Icecat (el gratuito por defecto; pon el tuyo si te registras)
# ICECAT_APP_KEY=               # solo con Full Icecat (de pago): la app_key de Mi Perfil en icecat.biz
# ICECAT_MAX_EXTRA=3            # fotos extra por producto

# --- NinaCash y niveles (página «NinaCash» del panel) ---
# Permisos extra de la app de Shopify: read_orders, write_orders, read_customers, write_customers,
# read_store_credit_accounts, write_store_credit_account_transactions, read_discounts, write_discounts
# y acceso a datos protegidos de clientes (nivel 1).
NINACASH_ACTIVO=false            # false = modo prueba (calcula y apunta, no cambia nada en Shopify)
# NINACASH_CRON=30 5 * * *       # repaso diario
# NINACASH_PCT_1=1               # % de NinaCash por nivel (Sparkle, Glow, Glam, Butterfly)
# NINACASH_PCT_2=1.5
# NINACASH_PCT_3=2
# NINACASH_PCT_4=2
# NIVEL_GLOW_DESDE=100           # € comprados en los últimos 12 meses
# NIVEL_GLAM_DESDE=250
# NIVEL_BUTTERFLY_DESDE=500
# NINACASH_ABONO=inmediato       # inmediato = se suma al pagar; tras-devolucion = 14 días después de la entrega
# NINACASH_DIAS_DEVOLUCION=14    # solo con NINACASH_ABONO=tras-devolucion
# NINACASH_CADUCIDAD_DIAS=365
# Avisos de NinaCash que caduca (30 y 7 días antes) por correo, con el SMTP de arriba
# SHOP_URL=https://www.ninabeauty.es

# --- Foro Nina (www.ninabeauty.es/apps/foro, vía proxy de aplicación) ---
# FORO_MODERACION=previa         # previa = revisas todo; confianza = clientas con mensajes aprobados publican solas
# FORO_CONFIANZA_MIN=2           # mensajes aprobados para ser «de confianza»
# FORO_DENUNCIAS_OCULTAR=3       # avisos de clientas distintas para ocultar un mensaje hasta revisarlo
# SHOPIFY_PROXY_SECRET=          # solo si el proxy firma con otro secreto distinto de SHOPIFY_CLIENT_SECRET

# --- Escuchar artículo en Nina Blog (ElevenLabs) ---
# ELEVENLABS_API_KEY=            # ElevenLabs → Developers → API Keys (solo aquí, en Railway)
# ELEVENLABS_VOICE_ID=           # opcional: la voz se elige en el panel /audio-blog
# ELEVENLABS_MODEL=eleven_multilingual_v2   # o eleven_flash_v2_5 (gasta la mitad de créditos)
