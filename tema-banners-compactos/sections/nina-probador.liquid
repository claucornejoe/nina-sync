{%- render 'nina-cesta' -%}
{%- comment -%} Nina Beauty · Probador virtual de maquillaje (labios). Usa assets/nina-probador.js, .css y nina-probador-labios.json {%- endcomment -%}
{{ 'nina-probador.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} .np-seccion {
    max-width: 1240px; margin-inline: auto;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
  }
  #shopify-section-{{ section.id }} .np-cabecera { text-align: center; margin: 0 auto 28px; max-width: 640px; }
  #shopify-section-{{ section.id }} .np-antetitulo { margin: 0 0 6px; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: #C92F60; font-weight: 500; }
  #shopify-section-{{ section.id }} .np-titulo { margin: 0; font-size: clamp(32px, 4.4vw, 48px); line-height: 1.05; font-weight: 500; text-wrap: balance; }
  #shopify-section-{{ section.id }} .np-sub { margin: 12px 0 0; color: #6E6E6E; }
  /* 2026-11-24: ventana de prueba más pequeña (−20 % ordenador, −10 % móvil) y marco destacado */
  @media (min-width: 861px) {
    #shopify-section-{{ section.id }} .np-rejilla { grid-template-columns: minmax(0, .82fr) minmax(0, 1fr); }
  }
  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .np-escenario.np-activo { height: min(50vh, 108vw); }
    #shopify-section-{{ section.id }} .np-escenario:not(.np-activo) { min-height: 306px; }
  }
  {%- if section.settings.destacar %}
  #shopify-section-{{ section.id }} .np-marco {
    position: relative; border-radius: 28px; padding: 34px 28px 28px;
    background: linear-gradient(#FFF6F8, #FFF6F8) padding-box, linear-gradient(135deg, #F72E75 0%, #C92F60 100%) border-box;
    border: 3px solid transparent; box-shadow: 0 18px 44px rgba(201, 47, 96, .16);
  }
  #shopify-section-{{ section.id }} .np-sello {
    position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%); z-index: 4;
    background: linear-gradient(135deg, #F72E75 0%, #C92F60 100%); color: #fff;
    font: 700 11px/1 Montserrat, var(--font-body--family), sans-serif; letter-spacing: .16em; text-transform: uppercase;
    padding: 9px 18px; border-radius: 999px; white-space: nowrap; box-shadow: 0 6px 16px rgba(201, 47, 96, .3);
  }
  #shopify-section-{{ section.id }} .np-marco .np-cabecera { margin-bottom: 20px; }
  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .np-marco { border-radius: 22px; padding: 28px 12px 14px; }
    #shopify-section-{{ section.id }} .np-sello { font-size: 10px; padding: 8px 14px; }
  }
  {%- endif %}
</style>
<div class="np-seccion" data-np-pais="{{ localization.country.iso_code }}">
  {%- if section.settings.destacar -%}<div class="np-marco">{%- if section.settings.sello != blank -%}<span class="np-sello">{{ section.settings.sello }}</span>{%- endif -%}{%- endif -%}
  {%- if section.settings.titulo != blank -%}
    <header class="np-cabecera">
      {%- if section.settings.antetitulo != blank -%}<p class="np-antetitulo">{{ section.settings.antetitulo }}</p>{%- endif -%}
      <h1 class="np-titulo h1">{{ section.settings.titulo }}</h1>
      {%- if section.settings.texto != blank -%}<div class="np-sub">{{ section.settings.texto }}</div>{%- endif -%}
    </header>
  {%- endif -%}
  <div
    data-nina-probador
    data-tonos-url="{{ 'nina-probador-labios.json' | asset_url }}"
    data-carrito="{{ section.settings.carrito }}"
  >
    <noscript>Para usar el probador virtual necesitas activar JavaScript.</noscript>
  </div>
  {%- comment -%} Stock real de los tonos del probador (colección «probador-labios»): [sku, código de barras, disponible, unidades, política, gestión] {%- endcomment -%}
  {%- comment -%} Stock principal: metacampo de la tienda nina.probador_stock {ean: unidades}, igual para todos los países {%- endcomment -%}
  <script type="application/json" data-np-stock-tienda>{{ shop.metafields.nina.probador_stock.value | json }}</script>
  {%- assign np_coleccion = collections['probador-labios'] -%}
  <script type="application/json" data-np-stock>[
    {%- if np_coleccion -%}
      {%- paginate np_coleccion.products by 100 -%}
        {%- for p in np_coleccion.products -%}
          {%- for v in p.variants -%}["{{ v.sku | escape }}","{{ v.barcode | escape }}",{{ v.available }},{{ v.inventory_quantity | default: 0 }},"{{ v.inventory_policy }}","{{ v.inventory_management }}"],{%- endfor -%}
        {%- endfor -%}
      {%- endpaginate -%}
    {%- endif -%}
  null]</script>
  {%- if section.settings.destacar -%}</div>{%- endif -%}
</div>
<script type="module" src="{{ 'nina-probador.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Probador virtual",
  "tag": "section",
  "class": "nina-probador",
  "settings": [
    { "type": "text", "id": "antetitulo", "label": "Antetítulo", "default": "Probador virtual" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Encuentra tu labial ideal" },
    { "type": "richtext", "id": "texto", "label": "Texto", "default": "<p>Activa la cámara, elige una marca y prueba los tonos más vendidos en tus labios.</p>" },
    { "type": "checkbox", "id": "destacar", "label": "Enmarcar en rosa para destacarlo", "default": true },
    { "type": "text", "id": "sello", "label": "Etiqueta sobre el marco", "default": "Nuevo · Gratis y al instante" },
    { "type": "checkbox", "id": "carrito", "label": "Mostrar botón «Añadir a la cesta»", "default": true },
    { "type": "range", "id": "padding_top", "label": "Margen superior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Margen inferior", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "Probador virtual" }]
}
{% endschema %}
