{% comment %} Nina: pie de página de toda la web (contacto, Nina Beauty, ayuda, legal y NinaCash). {% endcomment %}
{%- liquid
  assign s = section.settings
  assign p_sobre = pages['sobre-nosotros']
  assign p_cookies = pages['politica-de-cookies']
  assign p_contacto = pages['contact']
  assign p_ninacash = pages['ninacash']
  assign p_probador = pages['probador-virtual']
  assign p_cuenta = pages['mi-cuenta']
  assign url_contacto = p_contacto.url | default: '/pages/contact'
  assign url_ninacash = p_ninacash.url | default: '/pages/ninacash'
-%}
<style>
  .npie{--r:#F72E75;--p:#FFCCD5;--b:#C92F60;--t:#2B2B2B;background:var(--t);color:#fff;font-family:Montserrat,var(--font-body--family),sans-serif;
        --mar:url('{{ 'nina-mariposa-rosa.svg' | asset_url }}')}
  .npie *{box-sizing:border-box}
  .npie a{color:inherit;text-decoration:none}
  .npie-serif{font-family:'Cormorant Garamond',Cormorant,var(--font-heading--family),serif;font-weight:500}
  .npie-wrap{max-width:1240px;margin:0 auto;padding:0 24px}
  .npie-mar{display:inline-block;flex:0 0 auto;width:18px;height:18px;background:currentColor;-webkit-mask:var(--mar) center/contain no-repeat;mask:var(--mar) center/contain no-repeat}
  .npie-ventajas{background:var(--r);color:#fff}
  .npie-ventajas ul{list-style:none;margin:0 auto;padding:14px 24px;max-width:1240px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
  .npie-ventajas li{display:flex;align-items:center;justify-content:center;gap:10px;font-size:13px;font-weight:600;text-align:left}
  .npie-ventajas svg{width:22px;height:22px;flex:0 0 auto}
  .npie-grid{display:grid;grid-template-columns:minmax(0,1.25fr) repeat(3,minmax(0,.8fr)) minmax(0,1.35fr);gap:36px;padding:48px 0 36px}
  .npie-marca img{display:block;width:170px;height:auto}
  .npie-marca p{margin:14px 0 16px;font-size:13.5px;line-height:1.6;color:rgba(255,255,255,.78)}
  .npie-contacto{display:flex;flex-direction:column;gap:8px;font-size:13.5px}
  .npie-contacto a{display:inline-flex;align-items:center;gap:8px;color:#fff}
  .npie-contacto a:hover{color:var(--p)}
  .npie-contacto svg{width:17px;height:17px;flex:0 0 auto;color:var(--p)}
  .npie-redes{display:flex;gap:10px;margin-top:16px}
  .npie-redes a{width:36px;height:36px;border-radius:50%;border:1px solid rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center}
  .npie-redes a:hover{background:var(--r);border-color:var(--r)}
  .npie-redes svg{width:17px;height:17px}
  .npie-col h3{margin:4px 0 14px;font:700 11.5px Montserrat,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--p)}
  .npie-col ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
  .npie-col a{font-size:13.5px;color:rgba(255,255,255,.86);line-height:1.35}
  .npie-col a:hover{color:#fff;text-decoration:underline;text-underline-offset:3px}
  .npie-nc{position:relative;overflow:hidden;isolation:isolate;background:linear-gradient(135deg,#F72E75 0%,#C92F60 100%);border-radius:22px;padding:22px 22px 20px}
  .npie-nc::after{content:'';position:absolute;z-index:-1;right:-40px;top:-46px;width:170px;height:170px;background:#fff;opacity:.12;transform:rotate(18deg);-webkit-mask:var(--mar) center/contain no-repeat;mask:var(--mar) center/contain no-repeat}
  .npie-nc__top{display:flex;align-items:center;gap:8px}
  .npie-nc__top .npie-mar{width:24px;height:24px}
  .npie-nc__top strong{font-size:27px;line-height:1}
  .npie-nc__sub{margin:4px 0 12px;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#FFE3EB}
  .npie-nc ul{list-style:none;margin:0 0 14px;padding:0;display:grid;gap:7px}
  .npie-nc li{position:relative;padding-left:20px;font-size:12.5px;line-height:1.45}
  .npie-nc li::before{content:'';position:absolute;left:0;top:2px;width:13px;height:13px;background:#fff;-webkit-mask:var(--mar) center/contain no-repeat;mask:var(--mar) center/contain no-repeat}
  .npie-nc li b{font-weight:700}
  .npie-nc__btn{display:inline-flex;align-items:center;gap:6px;background:#fff;color:var(--b) !important;border-radius:999px;padding:10px 18px;font-size:11.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .npie-nc__btn:hover{background:var(--p)}
  .npie-base{border-top:1px solid rgba(255,255,255,.14)}
  .npie-base .npie-wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:18px;padding-bottom:22px}
  .npie-base p{margin:0;font-size:12px;color:rgba(255,255,255,.66)}
  .npie-pagos{display:flex;flex-wrap:wrap;gap:6px;list-style:none;margin:0;padding:0}
  .npie-pagos svg{width:40px;height:26px;display:block;border-radius:4px}
  @media (max-width: 1100px){
    .npie-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:30px 24px}
    .npie-marca{grid-column:1/-1}
    .npie-nc{grid-column:1/-1}
  }
  @media (max-width: 749px){
    .npie-wrap{padding:0 16px}
    .npie-ventajas ul{grid-template-columns:repeat(2,minmax(0,1fr));padding:12px 16px;gap:10px 12px}
    .npie-ventajas li{justify-content:flex-start;font-size:12px;gap:8px}
    .npie-ventajas svg{width:19px;height:19px}
    .npie-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 18px;padding:30px 0 26px}
    .npie-marca{grid-column:1/-1;display:grid;grid-template-columns:auto 1fr;gap:4px 16px;align-items:center}
    .npie-marca img{width:118px;grid-row:span 2}
    .npie-marca p{margin:0;font-size:12.5px}
    .npie-contacto{grid-column:1/-1;flex-direction:row;flex-wrap:wrap;gap:8px 18px;margin-top:8px}
    .npie-redes{grid-column:1/-1;margin-top:6px}
    .npie-col h3{margin-bottom:10px}
    .npie-col ul{gap:9px}
    .npie-col a{font-size:13px}
    .npie-col--legal{grid-column:1/-1}
    .npie-col--legal ul{grid-template-columns:repeat(2,minmax(0,1fr))}
    .npie-nc{grid-column:1/-1;padding:18px 18px 16px}
    .npie-base .npie-wrap{flex-direction:column-reverse;align-items:flex-start;gap:12px}
  }
</style>

<div class="npie">
  <div class="npie-ventajas">
    <ul>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>{{ s.ventaja_1 }}</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>{{ s.ventaja_2 }}</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>{{ s.ventaja_3 }}</li>
      <li><i class="npie-mar" style="width:22px;height:22px" aria-hidden="true"></i>{{ s.ventaja_4 }}</li>
    </ul>
  </div>

  <div class="npie-wrap">
    <div class="npie-grid">
      <div class="npie-marca">
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}"><img src="{{ 'nina-logo-fondo-negro.svg' | asset_url }}" alt="{{ shop.name }}" width="170" height="85" loading="lazy"></a>
        <p>{{ s.texto }}</p>
        <div class="npie-contacto">
          <a href="{{ url_contacto }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/></svg>Escríbenos</a>
          {%- if s.email != blank -%}<a href="mailto:{{ s.email }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>{{ s.email }}</a>{%- endif -%}
          {%- if s.horario != blank -%}<span style="font-size:12.5px;color:rgba(255,255,255,.66)">{{ s.horario }}</span>{%- endif -%}
        </div>
        {%- if s.instagram != blank or s.tiktok != blank or s.facebook != blank or s.pinterest != blank or s.youtube != blank -%}
          <div class="npie-redes">
            {%- if s.instagram != blank -%}<a href="{{ s.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}
            {%- if s.tiktok != blank -%}<a href="{{ s.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 3c.3 2.3 1.7 3.8 4 4v3a7 7 0 0 1-4-1.3v6.1A5.9 5.9 0 1 1 10.7 9v3.1a2.9 2.9 0 1 0 2.9 2.8V3z"/></svg></a>{%- endif -%}
            {%- if s.facebook != blank -%}<a href="{{ s.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5H16l.4-3h-2.9V8.7c0-.9.3-1.5 1.5-1.5h1.6V4.5c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.2H8v3h2.5V21z"/></svg></a>{%- endif -%}
            {%- if s.pinterest != blank -%}<a href="{{ s.pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3a9 9 0 0 0-3.3 17.4c-.1-.8-.1-1.9 0-2.7l1.1-4.6s-.3-.6-.3-1.4c0-1.3.8-2.3 1.7-2.3.8 0 1.2.6 1.2 1.3 0 .8-.5 2-.8 3.1-.2.9.5 1.7 1.4 1.7 1.7 0 3-1.8 3-4.4 0-2.3-1.6-3.9-4-3.9-2.7 0-4.3 2-4.3 4.1 0 .8.3 1.7.7 2.2l.1.4-.3 1.1c0 .2-.2.3-.4.2-1.2-.6-2-2.3-2-3.8 0-3.1 2.2-5.9 6.5-5.9 3.4 0 6 2.4 6 5.7 0 3.4-2.1 6.1-5.1 6.1-1 0-1.9-.5-2.2-1.1l-.6 2.3c-.2.9-.8 1.9-1.2 2.6A9 9 0 1 0 12 3z"/></svg></a>{%- endif -%}
            {%- if s.youtube != blank -%}<a href="{{ s.youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3z"/></svg></a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <nav class="npie-col" aria-label="Ayuda">
        <h3>Ayuda</h3>
        <ul>
          <li><a href="{{ url_contacto }}">Contacto</a></li>
          {%- if shop.shipping_policy != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Envíos y entregas</a></li>{%- endif -%}
          {%- if shop.refund_policy != blank -%}<li><a href="{{ shop.refund_policy.url }}">Devoluciones</a></li>{%- endif -%}
          <li><a href="{{ routes.account_url }}">Mis pedidos</a></li>
          <li><a href="{{ p_cuenta.url | default: routes.account_url }}">Mi cuenta</a></li>
        </ul>
      </nav>

      <nav class="npie-col" aria-label="Nina Beauty">
        <h3>Nina Beauty</h3>
        <ul>
          {%- if p_sobre.url != blank -%}<li><a href="{{ p_sobre.url }}">Sobre nosotros</a></li>{%- endif -%}
          <li><a href="{{ url_ninacash }}">NinaCash y niveles</a></li>
          {%- if p_probador.url != blank -%}<li><a href="{{ p_probador.url }}">Probador virtual</a></li>{%- endif -%}
          {%- for link in linklists[s.menu].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        </ul>
      </nav>

      <nav class="npie-col npie-col--legal" aria-label="Legal">
        <h3>Legal</h3>
        <ul>
          {%- for pol in shop.policies -%}
            {%- if pol == blank or pol.url contains 'shipping-policy' or pol.url contains 'refund-policy' -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign nombre = pol.title
              if pol.url contains 'terms-of-service'
                assign nombre = 'Condiciones de venta'
              elsif pol.url contains 'legal-notice'
                assign nombre = 'Aviso legal'
              elsif pol.url contains 'privacy-policy'
                assign nombre = 'Política de privacidad'
              elsif pol.url contains 'contact-information'
                assign nombre = 'Datos de la tienda'
              endif
            -%}
            <li><a href="{{ pol.url }}">{{ nombre }}</a></li>
          {%- endfor -%}
          {%- if p_cookies.url != blank -%}<li><a href="{{ p_cookies.url }}">Política de cookies</a></li>{%- endif -%}
        </ul>
      </nav>

      <div class="npie-nc">
        <div class="npie-nc__top"><i class="npie-mar" aria-hidden="true"></i><strong class="npie-serif">NinaCash</strong></div>
        <p class="npie-nc__sub">Lo que debes saber</p>
        <ul>
          <li><b>1 NinaCash = 1 €</b> para gastar en Nina Beauty.</li>
          <li>Ganas del <b>1 % al 2 %</b> de cada pedido, según tu nivel.</li>
          <li>Aparece al momento y se usa <b>al pagar</b>, con tu cuenta iniciada.</li>
          <li>Caduca a los <b>12 meses</b>. Te avisamos antes por correo.</li>
          <li>Si cancelas o devuelves un pedido, <b>se resta</b> lo que generó.</li>
        </ul>
        <a class="npie-nc__btn" href="{{ url_ninacash }}">Condiciones completas <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <div class="npie-base">
    <div class="npie-wrap">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ s.base }}</p>
      {%- if s.pagos and shop.enabled_payment_types.size > 0 -%}
        <ul class="npie-pagos" aria-label="Formas de pago">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nina · Pie de página",
  "tag": "div",
  "class": "nina-pie",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "paragraph", "content": "Los enlaces de Envíos, Devoluciones y Legal salen solos de Configuración › Políticas. «Sobre nosotros» y «Política de cookies» salen si existen esas páginas." },
    { "type": "header", "content": "Franja rosa de arriba" },
    { "type": "text", "id": "ventaja_1", "label": "Ventaja 1", "default": "Envío gratis desde 49 €" },
    { "type": "text", "id": "ventaja_2", "label": "Ventaja 2", "default": "Entrega en 24-72 h" },
    { "type": "text", "id": "ventaja_3", "label": "Ventaja 3", "default": "Pago 100 % seguro" },
    { "type": "text", "id": "ventaja_4", "label": "Ventaja 4", "default": "NinaCash en cada compra" },
    { "type": "header", "content": "Nina Beauty y contacto" },
    { "type": "textarea", "id": "texto", "label": "Texto bajo el logo", "default": "Perfumes, maquillaje y cosmética original con envío a península y Baleares." },
    { "type": "text", "id": "email", "label": "Correo de contacto", "info": "Opcional. Si lo dejas vacío, solo sale «Escríbenos» (formulario de contacto)." },
    { "type": "text", "id": "horario", "label": "Horario de atención", "info": "Opcional. Por ejemplo: Lunes a viernes, de 9 a 18 h." },
    { "type": "link_list", "id": "menu", "label": "Enlaces extra en «Nina Beauty»", "info": "Opcional. Un menú de Contenido › Menús." },
    { "type": "header", "content": "Redes sociales" },
    { "type": "paragraph", "content": "Solo se muestran las que tengan enlace." },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "pinterest", "label": "Pinterest" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "header", "content": "Franja de abajo" },
    { "type": "text", "id": "base", "label": "Texto junto al ©", "default": "Precios con IVA incluido." },
    { "type": "checkbox", "id": "pagos", "label": "Mostrar formas de pago", "default": true }
  ],
  "presets": [{ "name": "Nina · Pie de página" }]
}
{% endschema %}
