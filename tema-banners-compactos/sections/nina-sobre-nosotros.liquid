{% comment %} Nina: página «Sobre nosotros». Los textos se cambian en el editor del tema. {% endcomment %}
{%- assign s = section.settings -%}
<style>
  .nsn{--r:#F72E75;--p:#FFCCD5;--ps:#FFF3F6;--b:#C92F60;--t:#2B2B2B;--g:#6E6E6E;--l:#F1E3E7;color:var(--t);font-family:Montserrat,var(--font-body--family),sans-serif;
       --mar:url('{{ 'nina-mariposa-rosa.svg' | asset_url }}')}
  .nsn *{box-sizing:border-box}
  .nsn-serif{font-family:'Cormorant Garamond',Cormorant,var(--font-heading--family),serif;font-weight:500}
  .nsn-wrap{max-width:1080px;margin:0 auto;padding:0 16px}
  .nsn-mar{display:inline-block;width:40px;height:40px;background:var(--r);-webkit-mask:var(--mar) center/contain no-repeat;mask:var(--mar) center/contain no-repeat}
  .nsn-hero{position:relative;overflow:hidden;isolation:isolate;background:linear-gradient(125deg,#F72E75 0%,#C92F60 100%);color:#fff;text-align:center;padding:40px 16px 46px}
  .nsn-hero::after{content:'';position:absolute;z-index:-1;right:-60px;top:-70px;width:280px;height:280px;background:#fff;opacity:.1;transform:rotate(18deg);-webkit-mask:var(--mar) center/contain no-repeat;mask:var(--mar) center/contain no-repeat}
  .nsn-hero .nsn-mar{background:#fff;width:44px;height:44px}
  .nsn-hero h1{color:#fff;font-size:clamp(34px,5.5vw,52px);line-height:1.05;margin:8px 0 10px}
  .nsn-hero p{max-width:600px;margin:0 auto;font-size:16px;line-height:1.6}
  .nsn-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;align-items:center;padding:48px 0 8px}
  .nsn-intro h2{font-size:clamp(28px,4vw,40px);line-height:1.08;margin:0 0 12px;color:var(--t)}
  .nsn-intro .nsn-rte{font-size:15px;line-height:1.75;color:#4A4A4A}
  .nsn-intro .nsn-rte p{margin:0 0 12px}
  .nsn-cita{background:var(--ps);border:1px solid var(--p);border-radius:24px;padding:30px 28px;text-align:center}
  .nsn-cita blockquote{margin:10px 0 0;font-size:clamp(24px,3vw,30px);line-height:1.25;color:var(--b)}
  .nsn-sec{padding:44px 0 0}
  .nsn-sec>h2{text-align:center;font-size:clamp(28px,4vw,38px);margin:0 0 22px}
  .nsn-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .nsn-card{background:#fff;border:1px solid var(--l);border-radius:20px;padding:22px 20px}
  .nsn-card i{display:flex;width:44px;height:44px;border-radius:50%;background:var(--p);color:var(--b);align-items:center;justify-content:center;margin-bottom:10px}
  .nsn-card i svg{width:22px;height:22px}
  .nsn-card h3{font-size:25px;margin:0 0 6px;color:var(--t)}
  .nsn-card p{margin:0;font-size:14px;line-height:1.6;color:var(--g)}
  .nsn-card a{color:var(--b);font-weight:600;font-size:13px;text-decoration:underline;text-underline-offset:3px}
  .nsn-card--sc{background:#EEF7FA;border-color:#CDEAF3}
  .nsn-card--sc i{background:#DDF1F7;color:#2F6577}
  .nsn-card--sc h3{color:#1F3A43}
  .nsn-card--sc a{color:#2F6577}
  .nsn-cta{margin:48px 0 64px;background:var(--p);border-radius:24px;padding:30px 24px;text-align:center}
  .nsn-cta h2{font-size:32px;margin:6px 0 6px}
  .nsn-cta p{margin:0 0 18px;color:#5C3A46;font-size:15px}
  .nsn-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .nsn-btn{display:inline-flex;align-items:center;background:var(--b);color:#fff !important;text-decoration:none;padding:14px 28px;border-radius:999px;font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:600}
  .nsn-btn--line{background:#fff;color:var(--t) !important;border:1px solid var(--t)}
  @media (max-width:860px){.nsn-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:640px){
    .nsn-hero{padding:28px 16px 32px}.nsn-hero p{font-size:14px}
    .nsn-intro{grid-template-columns:1fr;gap:20px;padding-top:30px}
    .nsn-cards{grid-template-columns:1fr;gap:10px}
    .nsn-card{padding:16px;display:grid;grid-template-columns:44px 1fr;gap:0 14px;align-items:start}
    .nsn-card i{grid-row:span 3;margin:0}
    .nsn-card h3{font-size:22px}
    .nsn-cta{margin:36px 0 44px}
  }
</style>

<div class="nsn">
  <section class="nsn-hero">
    <i class="nsn-mar" aria-hidden="true"></i>
    <h1 class="nsn-serif">{{ s.titulo }}</h1>
    <p>{{ s.subtitulo }}</p>
  </section>

  <div class="nsn-wrap">
    <div class="nsn-intro">
      <div>
        <h2 class="nsn-serif">{{ s.intro_titulo }}</h2>
        <div class="nsn-rte">{{ s.intro_texto }}</div>
      </div>
      <div class="nsn-cita">
        <i class="nsn-mar" aria-hidden="true"></i>
        <blockquote class="nsn-serif">{{ s.frase }}</blockquote>
      </div>
    </div>

    <section class="nsn-sec">
      <h2 class="nsn-serif">{{ s.cards_titulo }}</h2>
      <div class="nsn-cards">
        <div class="nsn-card"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v6c0 4.5 3.2 7.8 7.5 9 4.3-1.2 7.5-4.5 7.5-9V6z"/><path d="m8.8 12 2.2 2.2 4.4-4.4"/></svg></i>
          <h3 class="nsn-serif">Solo originales</h3><p>Todos nuestros perfumes, maquillaje y cosmética son originales, de distribuidores de confianza.</p></div>
        <div class="nsn-card"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg></i>
          <h3 class="nsn-serif">Envío rápido</h3><p>Entrega en 24-72 h en península y Baleares. Gratis desde 49 €.</p></div>
        <div class="nsn-card"><i><span class="nsn-mar" style="width:22px;height:22px;background:currentColor"></span></i>
          <h3 class="nsn-serif">NinaCash</h3><p>Cada compra te devuelve entre el 1 % y el 2 % para la siguiente. <a href="{{ pages['ninacash'].url | default: '/pages/ninacash' }}">Cómo funciona</a></p></div>
        <div class="nsn-card"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg></i>
          <h3 class="nsn-serif">Pruébatelo antes</h3><p>Con el probador virtual ves cómo te queda cada labial con tu cámara. <a href="{{ pages['probador-virtual'].url | default: '/pages/probador-virtual' }}">Probar ahora</a></p></div>
        <div class="nsn-card nsn-card--sc"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c3 4 6 6.5 6 10a6 6 0 0 1-12 0c0-3.5 3-6 6-10z"/></svg></i>
          <h3 class="nsn-serif">Nina Skin Care</h3><p>Nuestro rincón de cuidado de la piel, con cosmética coreana y rutinas que funcionan. <a href="{{ pages['skin-care'].url | default: '/pages/skin-care' }}">Descubrir</a></p></div>
        <div class="nsn-card"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/></svg></i>
          <h3 class="nsn-serif">Trato cercano</h3><p>¿Dudas con un producto, un pedido o tu NinaCash? Escríbenos y te ayudamos.</p></div>
      </div>
    </section>

    <div class="nsn-cta">
      <i class="nsn-mar" aria-hidden="true"></i>
      <h2 class="nsn-serif">{{ s.cta_titulo }}</h2>
      <p>{{ s.cta_texto }}</p>
      <div class="nsn-btns">
        <a class="nsn-btn" href="{{ routes.all_products_collection_url }}">Ver la tienda</a>
        <a class="nsn-btn nsn-btn--line" href="{{ pages['contact'].url | default: '/pages/contact' }}">Escríbenos</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nina · Sobre nosotros",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Sobre Nina Beauty" },
    { "type": "text", "id": "subtitulo", "label": "Subtítulo", "default": "Belleza original, precios justos y un trato cercano, con envío a toda la península y Baleares." },
    { "type": "text", "id": "intro_titulo", "label": "Título de la historia", "default": "Hola, somos Nina" },
    { "type": "richtext", "id": "intro_texto", "label": "Nuestra historia", "default": "<p>Nina Beauty nace con una idea sencilla: que comprar perfumes, maquillaje y cosmética original en España sea fácil, bonito y a buen precio.</p><p>Elegimos cada marca pensando en lo que de verdad nos gusta usar, desde los grandes perfumes de siempre hasta los árabes que arrasan y el skincare coreano. Y como creemos que cuidarse tiene premio, cada compra te devuelve NinaCash para la siguiente.</p>" },
    { "type": "text", "id": "frase", "label": "Frase destacada", "default": "«Que cada pedido te haga sentir tan bien como abrir un regalo.»" },
    { "type": "text", "id": "cards_titulo", "label": "Título de las tarjetas", "default": "Por qué comprar en Nina" },
    { "type": "text", "id": "cta_titulo", "label": "Título final", "default": "¿Te ayudamos a elegir?" },
    { "type": "text", "id": "cta_texto", "label": "Texto final", "default": "Escríbenos y te recomendamos el perfume o la rutina que buscas." }
  ],
  "presets": [{ "name": "Nina · Sobre nosotros" }]
}
{% endschema %}
