{{ 'nina-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign nav = '/collections/ideas-para-navidad'
  assign sc_logo = 'nina-skincare-logo-azul.svg' | asset_url
  assign arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>'
-%}
<div class="nh">

  {%- if s.show_gifts -%}
  <section class="nh-band nh-band--petalo{% if s.gifts_foto != blank or s.gifts_foto_movil != blank %} nbf-on nbf--{{ s.gifts_velo }}{% endif %}">
    {%- render 'nina-foto-fondo', foto: s.gifts_foto, foto_movil: s.gifts_foto_movil -%}
    <div class="nh-wrap">
      <div class="nh-center">
        <span class="nh-kicker">{{ s.gifts_kicker }}</span>
        <h2 class="nh-h2 nh-serif" style="font-size:44px">{{ s.gifts_title }}</h2>
      </div>
      <div class="nh-gifts">
        <a class="nh-gift{% if s.g1_foto != blank %} nbf-on nbf--{{ s.g1_velo }}{% endif %}" href="{{ nav }}?filter.v.price.lte=30">
          {%- render 'nina-foto-fondo', foto: s.g1_foto -%}
          <div><span class="nh-gift__k">Detalles</span><div class="nh-gift__a nh-serif">Hasta 30 €</div></div>
          <p>Minis, colonias y sets pequeños para el amigo invisible y los compromisos.</p>
          <span class="nh-arrow">Ver regalos {{ arrow }}</span>
        </a>
        <a class="nh-gift{% if s.g2_foto != blank %} nbf-on nbf--{{ s.g2_velo }}{% endif %}" href="{{ nav }}?filter.v.price.gte=30&amp;filter.v.price.lte=60">
          {%- render 'nina-foto-fondo', foto: s.g2_foto -%}
          <div><span class="nh-gift__k">Los más regalados</span><div class="nh-gift__a nh-serif">30–60 €</div></div>
          <p>Estuches de perfume con loción o miniatura de regalo.</p>
          <span class="nh-arrow">Ver regalos {{ arrow }}</span>
        </a>
        <a class="nh-gift{% if s.g3_foto != blank %} nbf-on nbf--{{ s.g3_velo }}{% endif %}" href="{{ nav }}?filter.v.price.gte=60">
          {%- render 'nina-foto-fondo', foto: s.g3_foto -%}
          <div><span class="nh-gift__k">Para quedar genial</span><div class="nh-gift__a nh-serif">Más de 60 €</div></div>
          <p>Grandes fragancias y sets de lujo para alguien especial.</p>
          <span class="nh-arrow">Ver regalos {{ arrow }}</span>
        </a>
      </div>
    </div>
  </section>
  {%- endif -%}

  <div class="nh-wrap">
    <div class="nh-duo">
      <div class="nh-split nh-arab nh-duo__item">
        <div class="nh-arab__txt">
          <span class="nh-kicker" style="color:#E8C989">Perfumes árabes</span>
          <h2 class="nh-h2 nh-serif">{{ s.arab_title }}</h2>
          <p>{{ s.arab_text }}</p>
          <a class="nh-btn nh-btn--line" href="/collections/perfumes-arabes">Ver perfumes árabes</a>
        </div>
        <div class="nh-arab__art">
          {%- if s.arab_image != blank or s.arab_image_movil != blank -%}
            {%- assign arab_img = s.arab_image | default: s.arab_image_movil -%}
            <picture>
              {%- if s.arab_image_movil != blank -%}<source media="(max-width: 749px)" srcset="{{ s.arab_image_movil | image_url: width: 900 }} 900w, {{ s.arab_image_movil | image_url: width: 1200 }} 1200w" sizes="100vw">{%- endif -%}
              {{ arab_img | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}
            </picture>
          {%- else -%}
            <svg width="110" height="220" viewBox="0 0 110 220" aria-hidden="true"><path d="M55 0l14 22H41z" fill="#E8C989"/><rect x="45" y="22" width="20" height="24" fill="#C9A35C"/><path d="M55 46c38 18 52 52 52 94 0 50-26 78-52 78S3 190 3 140c0-42 14-76 52-94z" fill="#6B2E3A" stroke="#E8C989" stroke-width="2"/></svg>
            <svg width="90" height="180" viewBox="0 0 90 180" aria-hidden="true"><rect x="30" y="0" width="30" height="30" rx="15" fill="#E8C989"/><rect x="38" y="30" width="14" height="14" fill="#C9A35C"/><rect x="3" y="44" width="84" height="134" rx="10" fill="#1E1A16" stroke="#E8C989" stroke-width="2"/><path d="M25 90h40M25 100h40" stroke="#E8C989" stroke-width="1.5"/></svg>
          {%- endif -%}
        </div>
      </div>
      <div class="nh-scbox nh-duo__item{% if s.scb_foto != blank or s.scb_foto_movil != blank %} nbf-on nbf--{{ s.scb_velo }}{% endif %}">
        {%- render 'nina-foto-fondo', foto: s.scb_foto, foto_movil: s.scb_foto_movil -%}
        <div class="nh-scbox__head">
          <img src="{{ sc_logo }}" alt="Nina Skin Care" class="nh-scbox__logo" loading="lazy">
          <a class="nh-btn nh-scbox__btn" href="/pages/skin-care">Entrar {{ arrow }}</a>
        </div>
        <p class="nh-scbox__p">{{ s.sc_text }}</p>
        <div class="nh-sc nh-sc--mini">
          <a class="{% if s.sc1_foto != blank %} nbf-on nbf--{{ s.sc1_velo }}{% endif %}" href="/collections/skin-care-limpieza" style="background:#DDF1F7">{%- render 'nina-foto-fondo', foto: s.sc1_foto -%}<span>Paso 1</span><span class="nh-serif">Limpieza</span></a>
          <a class="{% if s.sc2_foto != blank %} nbf-on nbf--{{ s.sc2_velo }}{% endif %}" href="/collections/skin-care-serums" style="background:#CDEAF3">{%- render 'nina-foto-fondo', foto: s.sc2_foto -%}<span>Paso 2</span><span class="nh-serif">Sérums y ampollas</span></a>
          <a class="{% if s.sc3_foto != blank %} nbf-on nbf--{{ s.sc3_velo }}{% endif %}" href="/collections/skin-care-cremas" style="background:#CDEAF3">{%- render 'nina-foto-fondo', foto: s.sc3_foto -%}<span>Paso 3</span><span class="nh-serif">Cremas</span></a>
          <a class="{% if s.sc4_foto != blank %} nbf-on nbf--{{ s.sc4_velo }}{% endif %}" href="/collections/skin-care-solar" style="background:#DDF1F7">{%- render 'nina-foto-fondo', foto: s.sc4_foto -%}<span>Cada día</span><span class="nh-serif">Protección solar</span></a>
        </div>
      </div>
    </div>
  </div>

  {%- liquid
    assign brand_list = s.brands | split: ','
    assign n_marcas = 0
    for b in section.blocks
      if b.type == 'marca'
        assign n_marcas = n_marcas | plus: 1
      endif
    endfor
  -%}
  {%- if n_marcas > 0 or brand_list.size > 0 -%}
  <div class="nh-wrap nh-sec nh-marcas">
    <div class="nh-marcas__head">
      <h2 class="nh-h2 nh-serif">{{ s.brands_title }}</h2>
      <div class="nh-marcas__nav">
        <button type="button" class="nh-marcas__btn" data-dir="-1" aria-label="Marcas anteriores"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
        <button type="button" class="nh-marcas__btn" data-dir="1" aria-label="Más marcas"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
    </div>
    <div class="nh-marcas__track" data-nh-marcas data-vel="{{ s.brands_vel | default: 30 }}">
      {%- for vuelta in (1..2) -%}
        {%- if n_marcas > 0 -%}
          {%- for block in section.blocks -%}
            {%- unless block.type == 'marca' -%}{%- continue -%}{%- endunless -%}
            {%- assign bn = block.settings.nombre | strip -%}
            {%- capture bl -%}{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.collections_url }}/vendors?q={{ bn | url_encode }}{% endif %}{%- endcapture -%}
            <a class="nh-marca{% if block.settings.logo == blank %} nh-marca--txt{% endif %}" href="{{ bl }}"{% if vuelta == 2 %} aria-hidden="true" tabindex="-1"{% else %} {{ block.shopify_attributes }}{% endif %}>
              <span class="nh-marca__c">
                {%- if block.settings.logo != blank -%}
                  {{ block.settings.logo | image_url: width: 240 | image_tag: loading: 'lazy', alt: bn, widths: '120, 240' }}
                {%- else -%}
                  <span class="nh-marca__ini nh-serif">{{ bn }}</span>
                {%- endif -%}
              </span>
              <span class="nh-marca__n">{{ bn }}</span>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- for b in brand_list -%}
            {%- assign bn = b | strip -%}
            <a class="nh-marca nh-marca--txt" href="{{ routes.collections_url }}/vendors?q={{ bn | url_encode }}"{% if vuelta == 2 %} aria-hidden="true" tabindex="-1"{% endif %}>
              <span class="nh-marca__c"><span class="nh-marca__ini nh-serif">{{ bn }}</span></span>
              <span class="nh-marca__n">{{ bn }}</span>
            </a>
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <script>
  (function(){
    document.querySelectorAll('[data-nh-marcas]').forEach(function(tr){
      if(tr.dataset.ok) return; tr.dataset.ok='1';
      var vel=(parseFloat(tr.dataset.vel)||30)/60, pausa=false, raf=null, x=tr.scrollLeft;
      var quieto=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function mitad(){ return tr.scrollWidth/2; }
      function paso(){ if(!pausa){ x+=vel; if(x>=mitad()) x-=mitad(); tr.scrollLeft=x; } raf=requestAnimationFrame(paso); }
      function para(){ pausa=true; } function sigue(){ x=tr.scrollLeft; pausa=false; }
      ['mouseenter','touchstart','focusin'].forEach(function(e){ tr.addEventListener(e,para,{passive:true}); });
      tr.addEventListener('mouseleave',sigue); tr.addEventListener('focusout',sigue);
      tr.addEventListener('touchend',function(){ setTimeout(sigue,2500); },{passive:true});
      tr.addEventListener('scroll',function(){ if(pausa){ if(tr.scrollLeft>=mitad()) tr.scrollLeft-=mitad(); else if(tr.scrollLeft<=0) tr.scrollLeft+=mitad(); } },{passive:true});
      var caja=tr.closest('.nh-marcas');
      caja.querySelectorAll('.nh-marcas__btn').forEach(function(btn){
        btn.addEventListener('click',function(){ para(); var item=tr.querySelector('.nh-marca'); var w=item?item.getBoundingClientRect().width+16:140; tr.scrollBy({left:(+btn.dataset.dir)*w*3,behavior:'smooth'}); setTimeout(sigue,3000); });
      });
      if(!quieto) raf=requestAnimationFrame(paso);
    });
  })();
  </script>
  {%- endif -%}

  <div class="nh-wrap nh-sec" style="padding-top:64px">
    <div class="nh-cashbox{% if s.cash_foto != blank or s.cash_foto_movil != blank %} nbf-on nbf--{{ s.cash_velo }}{% endif %}">
      {%- render 'nina-foto-fondo', foto: s.cash_foto, foto_movil: s.cash_foto_movil -%}
      <div class="nh-center" style="margin-bottom:28px">
        <h2 class="nh-h2 nh-serif">{{ s.cash_title }}</h2>
        <p style="margin:0;font-size:15px;color:#4A4A4A;max-width:560px;line-height:1.6">{{ s.cash_text }}</p>
      </div>
      <div class="nh-steps">
        <div class="nh-step"><b class="nh-serif">1</b><strong>Crea tu cuenta</strong><span>Gratis, en un minuto.</span></div>
        <div class="nh-step"><b class="nh-serif">2</b><strong>Compra y acumula</strong><span>{{ s.cash_step2 }}</span></div>
        <div class="nh-step"><b class="nh-serif">3</b><strong>Úsalo en tu próxima compra</strong><span>{{ s.cash_step3 }}</span></div>
      </div>
      <div style="text-align:center;padding-top:24px"><a class="nh-btn nh-btn--main" href="{{ routes.account_url }}">Crear mi cuenta</a></div>
    </div>
  </div>

  <section class="nh-band nh-band--suave{% if s.club_foto != blank or s.club_foto_movil != blank %} nbf-on nbf--{{ s.club_velo }}{% endif %}">
    {%- render 'nina-foto-fondo', foto: s.club_foto, foto_movil: s.club_foto_movil -%}
    <div class="nh-wrap nh-split">
      <div style="display:flex;flex-direction:column;gap:10px">
        <h2 class="nh-h2 nh-serif">{{ s.club_title }}</h2>
        <p style="margin:0;font-size:15px;line-height:1.6;color:#4A4A4A">{{ s.club_text }}</p>
      </div>
      {%- form 'customer', id: 'nh-club' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, club-nina">
        {%- if form.posted_successfully? -%}
          <p class="nh-ok">¡Listo! Ya eres parte del Club Nina.</p>
        {%- else -%}
          <div style="display:flex;flex-direction:column;gap:10px">
            <label for="nh-club-mail" style="font-size:13px;font-weight:600">Tu correo electrónico</label>
            <div class="nh-news">
              <input id="nh-club-mail" type="email" name="contact[email]" required autocomplete="email" placeholder="nombre@correo.es">
              <button class="nh-btn nh-btn--main" type="submit">Suscribirme</button>
            </div>
            {%- if form.errors -%}<span class="nh-note" style="color:#C92F60">Revisa el correo e inténtalo de nuevo.</span>{%- endif -%}
            <span class="nh-note">Puedes darte de baja cuando quieras. Consulta la <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}" style="text-decoration:underline">política de privacidad</a>.</span>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </section>
</div>

{% schema %}
