  "name": "Nina · Portada resto",
  "tag": "section",
  "class": "nina-home-resto",
  "settings": [
    { "type": "header", "content": "Regalos por presupuesto" },
    { "type": "checkbox", "id": "show_gifts", "label": "Mostrar", "default": true },
    { "type": "text", "id": "gifts_kicker", "label": "Antetítulo", "default": "Navidad 2026" },
    { "type": "text", "id": "gifts_title", "label": "Título", "default": "Regalos según tu presupuesto" },
    {"type": "header", "content": "Foto: fondo de toda la franja de regalos"},
    {"type": "image_picker", "id": "gifts_foto", "label": "Foto de fondo (ordenador)", "info": "Opcional. Sin foto se ve el diseño de siempre."},
    {"type": "image_picker", "id": "gifts_foto_movil", "label": "Foto de fondo (móvil)", "info": "Opcional. Si la dejas vacía, en el móvil se usa la de ordenador."},
    {"type": "select", "id": "gifts_velo", "label": "Para que se lea el texto sobre la foto", "options": [{"value": "ninguno", "label": "Sin velo (foto tal cual)"}, {"value": "claro", "label": "Velo blanco y texto oscuro"}, {"value": "oscuro", "label": "Velo negro y texto blanco"}], "default": "claro"},
    {"type": "header", "content": "Foto: tarjeta «Hasta 30 €»"},
    {"type": "image_picker", "id": "g1_foto", "label": "Foto de fondo (ordenador)", "info": "Opcional. Sin foto se ve el diseño de siempre."},
    {"type": "select", "id": "g1_velo", "label": "Para que se lea el texto sobre la foto", "options": [{"value": "ninguno", "label": "Sin velo (foto tal cual)"}, {"value": "claro", "label": "Velo blanco y texto oscuro"}, {"value": "oscuro", "label": "Velo negro y texto blanco"}], "default": "claro"},
    {"type": "header", "content": "Foto: tarjeta «30–60 €»"},
    {"type": "image_picker", "id": "g2_foto", "label": "Foto de fondo (ordenador)", "info": "Opcional. Sin foto se ve el diseño de siempre."},
    {"type": "select", "id": "g2_velo", "label": "Para que se lea el texto sobre la foto", "options": [{"value": "ninguno", "label": "Sin velo (foto tal cual)"}, {"value": "claro", "label": "Velo blanco y texto oscuro"}, {"value": "oscuro", "label": "Velo negro y texto blanco"}], "default": "claro"},
    {"type": "header", "content": "Foto: tarjeta «Más de 60 €»"},
    {"type": "image_picker", "id": "g3_foto", "label": "Foto de fondo (ordenador)", "info": "Opcional. Sin foto se ve el diseño de siempre."},
    {"type": "select", "id": "g3_velo", "label": "Para que se lea el texto sobre la foto", "options": [{"value": "ninguno", "label": "Sin velo (foto tal cual)"}, {"value": "claro", "label": "Velo blanco y texto oscuro"}, {"value": "oscuro", "label": "Velo negro y texto blanco"}], "default": "claro"},
    { "type": "header", "content": "Perfumes árabes" },
    { "type": "image_picker", "id": "arab_image", "label": "Foto (ordenador)", "info": "Va en la mitad derecha del banner. Sin foto se ven los frascos dibujados." },
    { "type": "image_picker", "id": "arab_image_movil", "label": "Foto (móvil)", "info": "Opcional. Si la dejas vacía se usa la de ordenador." },
    { "type": "text", "id": "arab_title", "label": "Título", "default": "Oud, ámbar y vainilla que duran todo el día" },
