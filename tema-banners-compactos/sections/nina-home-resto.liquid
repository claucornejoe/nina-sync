    {"type": "header", "content": "Foto: tarjeta «Protección solar»"},
    {"type": "image_picker", "id": "sc4_foto", "label": "Foto de fondo (ordenador)", "info": "Opcional. Sin foto se ve el diseño de siempre."},
    {"type": "select", "id": "sc4_velo", "label": "Para que se lea el texto sobre la foto", "options": [{"value": "ninguno", "label": "Sin velo (foto tal cual)"}, {"value": "claro", "label": "Velo blanco y texto oscuro"}, {"value": "oscuro", "label": "Velo negro y texto blanco"}], "default": "claro"},
    { "type": "header", "content": "Marcas" },
    { "type": "text", "id": "brands_title", "label": "Título", "default": "Tus marcas favoritas" },
    { "type": "range", "id": "brands_vel", "label": "Velocidad del carrusel de marcas", "min": 10, "max": 80, "step": 5, "unit": "px", "default": 30, "info": "Píxeles por segundo. Para poner el logo de cada marca: «Añadir bloque» › «Marca»." },
    { "type": "textarea", "id": "brands", "label": "Marcas (separadas por comas)", "info": "Solo se usa si no hay bloques «Marca».", "default": "Lattafa, Paco Rabanne, Givenchy, Hermès, Jean Paul Gaultier, Tous, Carolina Herrera, Al Haramain, Issey Miyake, Dior" },
    { "type": "header", "content": "NinaCash" },
    { "type": "text", "id": "cash_title", "label": "Título", "default": "NinaCash: comprar te da dinero" },
    { "type": "text", "id": "cash_text", "label": "Texto", "default": "Por cada compra te guardamos el 1 % del precio en tu cuenta Nina." },
    { "type": "text", "id": "cash_step2", "label": "Paso 2", "default": "Un perfume de 50 € te da 0,50 € en NinaCash." },
    { "type": "text", "id": "cash_step3", "label": "Paso 3", "default": "Te lo descontamos en tu siguiente pedido." },
    {"type": "header", "content": "Foto: recuadro NinaCash"},
    {"type": "image_picker", "id": "cash_foto", "label": "Foto de fondo (ordenador)", "info": "Opcional. Sin foto se ve el diseño de siempre."},
    {"type": "image_picker", "id": "cash_foto_movil", "label": "Foto de fondo (móvil)", "info": "Opcional. Si la dejas vacía, en el móvil se usa la de ordenador."},
