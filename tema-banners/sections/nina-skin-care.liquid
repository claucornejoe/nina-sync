{% comment %}
  Nina Skin Care: portada de la sección de cuidado de la piel de Nina Beauty.
  Muestra solo productos con la etiqueta «skin-care» (colección skin-care y sus subcolecciones skin-care-*).
{% endcomment %}
{%- assign sc_main = collections['skin-care'] -%}
{%- assign sc_handles = 'skin-care-limpieza,skin-care-tonicos,skin-care-serums,skin-care-cremas,skin-care-ojos-labios,skin-care-mascarillas,skin-care-solar,skin-care-corporal,skin-care-hombre,skin-care-sets,skin-care-suplementos' | split: ',' -%}

<style>
  .nsc { --sc-azul: #89D3E9; --sc-bruma: #90B7C3; --sc-nude: #D8BDAF; --sc-arena: #E0CBAA;
         --sc-azul-suave: #EEF8FB; --sc-nude-suave: #F8F1EC; --sc-texto: #2B2B2B; --sc-gris: #6E6E6E;
         --sc-boton: #4F8496; color: var(--sc-texto); font-family: Montserrat, var(--font-body--family), sans-serif; }
  .nsc * { box-sizing: border-box; }
  .nsc a { color: inherit; text-decoration: none; }
  .nsc-serif { font-family: 'Cormorant Garamond', Cormorant, var(--font-heading--family), serif; font-weight: 500; }
  .nsc-wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }

  .nsc-hero { background: linear-gradient(180deg, var(--sc-azul-suave) 0%, #fff 100%); text-align: center; padding: 56px 0 48px; }
  .nsc-hero__logo { width: min(320px, 70vw); height: auto; display: block; margin: 0 auto 20px; }
  .nsc-hero h1 { font-size: clamp(30px, 5vw, 48px); line-height: 1.1; margin: 0 0 14px; color: var(--sc-texto); }
  .nsc-hero p { max-width: 560px; margin: 0 auto 26px; color: var(--sc-gris); font-size: 16px; line-height: 1.6; }
  .nsc-btn { display: inline-block; background: var(--sc-boton); color: #fff !important; padding: 14px 30px; border-radius: 999px;
             font-size: 14px; letter-spacing: .08em; text-transform: uppercase; font-weight: 500; transition: background .2s; }
  .nsc-btn:hover { background: #3E6C7C; }
  .nsc-btn--claro { background: #fff; color: var(--sc-boton) !important; border: 1px solid var(--sc-bruma); }
  .nsc-btn--claro:hover { background: var(--sc-azul-suave); }

  .nsc-h2 { text-align: center; font-size: clamp(26px, 3.6vw, 36px); margin: 0 0 8px; }
  .nsc-sub { text-align: center; color: var(--sc-gris); margin: 0 0 28px; font-size: 15px; }
  .nsc-block { padding: 48px 0; }

  .nsc-cats { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
  .nsc-cats > .nsc-cat { flex: 0 0 calc((100% - 80px) / 6); }
  .nsc-cat { display: flex; flex-direction: column; align-items: center; text-align: center; border-radius: 18px; padding: 18px 12px 16px;
             background: var(--sc-azul-suave); transition: transform .2s, box-shadow .2s; }
  .nsc-cat:nth-child(even) { background: var(--sc-nude-suave); }
  .nsc-cat:hover { transform: translateY(-3px); box-shadow: 0 8px 22px rgba(79,132,150,.15); }
  .nsc-cat__img { width: 96px; height: 96px; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; overflow: hidden; margin-bottom: 12px; }
  .nsc-cat__img img { width: 100%; height: 100%; object-fit: contain; }
  .nsc-cat__img img.nsc-cat__mar { width: 56%; height: 56%; }
  .nsc-cat__name { font-weight: 500; font-size: 14px; line-height: 1.3; }
  .nsc-cat__count { font-size: 12px; color: var(--sc-gris); margin-top: 4px; }

  .nsc-prods { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .nsc-prod { display: flex; flex-direction: column; }
  .nsc-prod__img { aspect-ratio: 1 / 1; background: #fff; border: 1px solid #EDF1F3; border-radius: 14px; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative; }
  .nsc-prod__img img { width: 100%; height: 100%; object-fit: contain; padding: 10px; }
  .nsc-prod__tag { position: absolute; top: 10px; left: 10px; background: var(--sc-boton); color: #fff; font-size: 11px; padding: 4px 9px; border-radius: 999px; letter-spacing: .04em; }
  .nsc-prod__brand { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--sc-bruma); margin: 12px 0 4px; }
  .nsc-prod__title { font-size: 14px; line-height: 1.4; margin: 0 0 6px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .nsc-prod__price { font-weight: 600; font-size: 15px; }
  .nsc-prod__price s { color: var(--sc-gris); font-weight: 400; font-size: 13px; margin-left: 6px; }
  .nsc-center { text-align: center; margin-top: 30px; }
  .nsc-empty { text-align: center; background: var(--sc-azul-suave); border-radius: 18px; padding: 40px 20px; color: var(--sc-gris); }
  .nsc-empty img { width: 64px; height: auto; margin-bottom: 10px; }

  .nsc-why { background: var(--sc-nude-suave); }
  .nsc-why__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; text-align: center; }
  .nsc-why__item h3 { font-size: 22px; margin: 10px 0 6px; }
  .nsc-why__item p { color: var(--sc-gris); font-size: 14px; line-height: 1.6; margin: 0; }
  .nsc-why__icon { width: 54px; height: 54px; border-radius: 50%; background: #fff; display: inline-flex; align-items: center; justify-content: center; color: var(--sc-boton); }
  .nsc-why__icon svg { width: 26px; height: 26px; }


  .nsc-kb { padding: 0 0 48px; }
  .nsc-kb__box { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 24px; border-radius: 24px; overflow: hidden;
                 background: linear-gradient(120deg, var(--sc-azul-suave) 0%, #FFFFFF 45%, var(--sc-nude-suave) 100%); border: 1px solid #E3EFF3; padding: 40px 44px; }
  .nsc-kb__eyebrow { display: inline-block; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--sc-boton); background: #fff; border: 1px solid var(--sc-azul); border-radius: 999px; padding: 6px 14px; margin-bottom: 14px; }
  .nsc-kb h2 { font-size: clamp(30px, 4.4vw, 46px); line-height: 1.05; margin: 0 0 12px; }
  .nsc-kb h2 span { color: var(--sc-bruma); font-style: italic; }
  .nsc-kb p { color: var(--sc-gris); font-size: 15px; line-height: 1.6; margin: 0 0 22px; max-width: 460px; }
  .nsc-kb__imgs { display: flex; justify-content: center; align-items: flex-end; gap: 14px; }
  .nsc-kb__img { width: 31%; aspect-ratio: 3 / 4; background: #fff; border-radius: 16px; box-shadow: 0 10px 26px rgba(79,132,150,.14); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .nsc-kb__img:nth-child(2) { transform: translateY(-18px); }
  .nsc-kb__img img { width: 100%; height: 100%; object-fit: contain; padding: 10px; }
  .nsc-kb__img img.nsc-kb__mar { width: 46%; height: auto; padding: 0; }
  .nsc-kb__foto { display: block; width: 100%; aspect-ratio: 4 / 3; border-radius: 18px; overflow: hidden; }
  .nsc-kb__foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 760px) {
    .nsc-kb__box { grid-template-columns: 1fr; padding: 28px 20px; text-align: center; }
    .nsc-kb p { margin-left: auto; margin-right: auto; }
    .nsc-kb__imgs { order: -1; }
  }

  @media (max-width: 989px) { .nsc-cats > .nsc-cat { flex-basis: calc((100% - 32px) / 3); } .nsc-prods { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) {
    .nsc-hero { padding: 36px 0 32px; }
    .nsc-cats { gap: 12px; } .nsc-cats > .nsc-cat { flex-basis: calc((100% - 12px) / 2); }
    .nsc-prods { grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .nsc-why__grid { grid-template-columns: 1fr; }
    .nsc-block { padding: 36px 0; }
  }
</style>

<div class="nsc">
  <section class="nsc-hero{% if section.settings.hero_foto != blank or section.settings.hero_foto_movil != blank %} nbf-on nbf--{{ section.settings.hero_velo }}{% endif %}">
    {%- render 'nina-foto-fondo', foto: section.settings.hero_foto, foto_movil: section.settings.hero_foto_movil, eager: true -%}
    <div class="nsc-wrap">
      <img class="nsc-hero__logo" src="{{ 'nina-skincare-logo-azul.svg' | asset_url }}" alt="Nina Skin Care" width="320" height="160">
      <h1 class="nsc-serif">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      <a class="nsc-btn" href="{{ sc_main.url | default: '/collections/skin-care' }}">{{ section.settings.button_label }}</a>
    </div>
  </section>

  <section class="nsc-block">
    <div class="nsc-wrap">
      <h2 class="nsc-h2 nsc-serif">Encuentra tu rutina</h2>
      <p class="nsc-sub">Elige por paso o por necesidad de tu piel</p>
      <div class="nsc-cats">
        {%- for h in sc_handles -%}
          {%- assign c = collections[h] -%}
          {%- if c != blank -%}
            <a class="nsc-cat" href="{{ c.url }}">
              <span class="nsc-cat__img">
                {%- if c.image -%}
                  <img src="{{ c.image | image_url: width: 200 }}" alt="{{ c.title | escape }}" loading="lazy" width="96" height="96">
                {%- elsif c.products.first.featured_image -%}
                  <img src="{{ c.products.first.featured_image | image_url: width: 200 }}" alt="{{ c.title | escape }}" loading="lazy" width="96" height="96">
                {%- else -%}
                  <img class="nsc-cat__mar" src="{{ 'nina-skincare-mariposa-azul.svg' | asset_url }}" alt="" loading="lazy" width="54" height="54">
                {%- endif -%}
              </span>
              <span class="nsc-cat__name">{{ c.title }}</span>
              {%- if c.products_count > 0 -%}
                <span class="nsc-cat__count">{{ c.products_count }} {% if c.products_count == 1 %}producto{% else %}productos{% endif %}</span>
              {%- else -%}
                <span class="nsc-cat__count">Muy pronto</span>
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>


  {%- assign kb = collections['skin-care-coreano'] -%}
  {%- if kb != blank and section.settings.kbeauty_show -%}
  <section class="nsc-kb">
    <div class="nsc-wrap">
      <div class="nsc-kb__box{% if section.settings.kb_foto != blank or section.settings.kb_foto_movil != blank %} nbf-on nbf--{{ section.settings.kb_velo }}{% endif %}">
        {%- render 'nina-foto-fondo', foto: section.settings.kb_foto, foto_movil: section.settings.kb_foto_movil -%}
        <div>
          <span class="nsc-kb__eyebrow">K-Beauty</span>
          <h2 class="nsc-serif">{{ section.settings.kbeauty_title }}</h2>
          {%- if section.settings.kbeauty_text != blank -%}<p>{{ section.settings.kbeauty_text }}</p>{%- endif -%}
          <a class="nsc-btn" href="{{ kb.url }}">{{ section.settings.kbeauty_button }}</a>
        </div>
        <a class="nsc-kb__imgs" href="{{ kb.url }}" aria-label="{{ section.settings.kbeauty_button | escape }}">
          {%- assign kb_n = 0 -%}
          {%- if section.settings.kb_lado != blank or section.settings.kb_lado_movil != blank -%}
            {%- assign kb_n = 9 -%}
            {%- assign kb_li = section.settings.kb_lado | default: section.settings.kb_lado_movil -%}
            <picture class="nsc-kb__foto">
              {%- if section.settings.kb_lado_movil != blank -%}<source media="(max-width: 760px)" srcset="{{ section.settings.kb_lado_movil | image_url: width: 900 }} 900w, {{ section.settings.kb_lado_movil | image_url: width: 1200 }} 1200w" sizes="100vw">{%- endif -%}
              {{ kb_li | image_url: width: 1000 | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 760px) 45vw, 100vw' }}
            </picture>
          {%- endif -%}
          {%- for p in kb.products -%}
            {%- if p.featured_image and kb_n < 3 -%}
              {%- assign kb_n = kb_n | plus: 1 -%}
              <span class="nsc-kb__img"><img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title | escape }}" loading="lazy" width="200" height="266"></span>
            {%- endif -%}
          {%- endfor -%}
          {%- if kb_n == 0 -%}
            <span class="nsc-kb__img"><img class="nsc-kb__mar" src="{{ 'nina-skincare-mariposa-azul.svg' | asset_url }}" alt="" width="60" height="80"></span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </section>
  {%- endif -%}

  <section class="nsc-block" style="padding-top:0">
    <div class="nsc-wrap">
      <h2 class="nsc-h2 nsc-serif">{{ section.settings.products_heading }}</h2>
      <p class="nsc-sub">Cuidado facial y corporal de las mejores marcas</p>
      {%- if sc_main != blank and sc_main.products_count > 0 -%}
        <div class="nsc-prods">
          {%- for p in sc_main.products limit: section.settings.products_limit -%}
            <a class="nsc-prod" href="{{ p.url }}">
              <span class="nsc-prod__img">
                {%- if p.featured_image -%}
                  <img src="{{ p.featured_image | image_url: width: 500 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" loading="lazy" width="250" height="250">
                {%- endif -%}
                {%- if p.tags contains 'oferta-semana' -%}<span class="nsc-prod__tag">Oferta</span>
                {%- elsif p.tags contains 'recien-llegado' -%}<span class="nsc-prod__tag">Nuevo</span>{%- endif -%}
              </span>
              <span class="nsc-prod__brand">{{ p.vendor }}</span>
              <span class="nsc-prod__title">{{ p.title }}</span>
              <span class="nsc-prod__price">
                {%- if p.price_varies -%}Desde {% endif -%}{{ p.price | money }}
                {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
              </span>
            </a>
          {%- endfor -%}
        </div>
        <div class="nsc-center"><a class="nsc-btn nsc-btn--claro" href="{{ sc_main.url }}">Ver todo Nina Skin Care</a></div>
      {%- else -%}
        <div class="nsc-empty">
          <img src="{{ 'nina-skincare-mariposa-azul.svg' | asset_url }}" alt="" width="64" height="64">
          <p>Estamos preparando la selección de Nina Skin Care. Muy pronto encontrarás aquí todo para cuidar tu piel.</p>
        </div>
      {%- endif -%}
    </div>
  </section>

  <section class="nsc-block nsc-why">
    <div class="nsc-wrap">
      <div class="nsc-why__grid">
        <div class="nsc-why__item">
          <span class="nsc-why__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 15.4 7.2 17.9l.9-5.4L4.2 8.7l5.4-.8z"/></svg></span>
          <h3 class="nsc-serif">Marcas originales</h3>
          <p>Clarins, Shiseido, Estée Lauder, Payot y muchas más, siempre producto original.</p>
        </div>
        <div class="nsc-why__item">
          <span class="nsc-why__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17.5" cy="17.5" r="1.6"/></svg></span>
          <h3 class="nsc-serif">Envío rápido</h3>
          <p>Recíbelo en 24-72 h en la península y Baleares.</p>
        </div>
        <div class="nsc-why__item">
          <span class="nsc-why__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
          <h3 class="nsc-serif">Pago seguro</h3>
          <p>Paga con PayPal o con tarjeta, sin necesidad de cuenta.</p>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Nina Skin Care",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu rutina de cuidado de la piel" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Limpieza, tónicos, sérums, cremas, protección solar y vitaminas de las mejores marcas, elegidos para que tu piel luzca sana y luminosa cada día." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver todos los productos" },
    {"type": "image_picker", "id": "hero_foto", "label": "Foto de fondo del banner de arriba (ordenador)", "info": "Opcional. Sin foto se ve el diseño de siempre."},
    {"type": "image_picker", "id": "hero_foto_movil", "label": "Foto de fondo del banner de arriba (móvil)", "info": "Opcional. Si la dejas vacía, en el móvil se usa la de ordenador."},
    {"type": "select", "id": "hero_velo", "label": "Para que se lea el texto sobre la foto", "options": [{"value": "ninguno", "label": "Sin velo (foto tal cual)"}, {"value": "claro", "label": "Velo blanco y texto oscuro"}, {"value": "oscuro", "label": "Velo negro y texto blanco"}], "default": "claro"},
    { "type": "text", "id": "products_heading", "label": "Título de productos", "default": "Favoritos de Nina Skin Care" },
    { "type": "range", "id": "products_limit", "label": "Productos a mostrar", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "header", "content": "Banner Skincare coreano" },
    { "type": "checkbox", "id": "kbeauty_show", "label": "Mostrar banner", "default": true },
    { "type": "text", "id": "kbeauty_title", "label": "Título del banner", "default": "Skincare <span>coreano</span>" },
    { "type": "textarea", "id": "kbeauty_text", "label": "Texto del banner", "default": "Rutinas por pasos, texturas ligeras e ingredientes como la centella asiática, el ácido hialurónico o la niacinamida. Laneige, Dr. Jart+, Innisfree, Missha y más." },
    { "type": "text", "id": "kbeauty_button", "label": "Texto del botón", "default": "Descubrir K-Beauty" },
    { "type": "image_picker", "id": "kb_lado", "label": "Foto de la derecha (ordenador)", "info": "Opcional. Sustituye a las 3 fotos de productos que salen solas." },
    { "type": "image_picker", "id": "kb_lado_movil", "label": "Foto de la derecha (móvil)", "info": "Opcional. En el móvil va arriba. Si la dejas vacía se usa la de ordenador." },
    {"type": "image_picker", "id": "kb_foto", "label": "Foto de fondo de todo el banner (ordenador)", "info": "Opcional. Sin foto se ve el diseño de siempre."},
    {"type": "image_picker", "id": "kb_foto_movil", "label": "Foto de fondo de todo el banner (móvil)", "info": "Opcional. Si la dejas vacía, en el móvil se usa la de ordenador."},
    {"type": "select", "id": "kb_velo", "label": "Para que se lea el texto sobre la foto", "options": [{"value": "ninguno", "label": "Sin velo (foto tal cual)"}, {"value": "claro", "label": "Velo blanco y texto oscuro"}, {"value": "oscuro", "label": "Velo negro y texto blanco"}], "default": "claro"}
  ],
  "presets": [{ "name": "Nina Skin Care" }]
}
{% endschema %}
