<div class="nina-ventajas" {{ block.shopify_attributes }}>
  <div class="nina-ventajas__item">
    <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
    <strong>{{ block.settings.titulo_1 }}</strong>
    <span>{{ block.settings.texto_1 }}</span>
  </div>
  <div class="nina-ventajas__item">
    <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
    <strong>{{ block.settings.titulo_2 }}</strong>
    <span>{{ block.settings.texto_2 }}</span>
  </div>
  <div class="nina-ventajas__item">
    <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 3-6.2"/><path d="M4 4v4h4"/></svg>
    <strong>{{ block.settings.titulo_3 }}</strong>
    <span>{{ block.settings.texto_3 }}</span>
  </div>
</div>

{% stylesheet %}
  .nina-ventajas {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    border-top: 1px solid #F1E4E8;
    border-bottom: 1px solid #F1E4E8;
    padding: 16px 0;
  }
  .nina-ventajas__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2px;
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .nina-ventajas__item svg { color: #C92F60; margin-bottom: 4px; }
  .nina-ventajas__item strong { font-weight: 600; }
  .nina-ventajas__item span { color: #6E6E6E; }
{% endstylesheet %}

{% schema %}
{
  "name": "Nina · Ventajas",
  "tag": null,
  "settings": [
    { "type": "text", "id": "titulo_1", "label": "Ventaja 1", "default": "Envío gratis" },
    { "type": "text", "id": "texto_1", "label": "Detalle 1", "default": "desde 49 €" },
    { "type": "text", "id": "titulo_2", "label": "Ventaja 2", "default": "100 % original" },
    { "type": "text", "id": "texto_2", "label": "Detalle 2", "default": "marcas oficiales" },
    { "type": "text", "id": "titulo_3", "label": "Ventaja 3", "default": "Devoluciones" },
    { "type": "text", "id": "texto_3", "label": "Detalle 3", "default": "14 días" }
  ],
  "presets": [{ "name": "Nina · Ventajas", "category": "Nina" }]
}
{% endschema %}
